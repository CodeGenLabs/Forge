diff --git a/tools/__tests__/apply-token-only.test.ts b/tools/__tests__/apply-token-only.test.ts
new file mode 100644
index 0000000..b8b23a3
--- /dev/null
+++ b/tools/__tests__/apply-token-only.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, it } from 'vitest'
+import { METHODS } from '../../packages/contract/src/index'
+
+/** Lấy danh sách key của một zod object schema, bóc các lớp bọc (optional, default, effects). */
+function paramKeys(schema: unknown): string[] {
+  let inner: unknown = schema
+  for (let i = 0; i < 6 && inner; i++) {
+    const shape = (inner as { shape?: Record<string, unknown> }).shape
+    if (shape && typeof shape === 'object') return Object.keys(shape)
+    const def = (inner as { _def?: { innerType?: unknown; schema?: unknown; shape?: unknown } })._def
+    if (typeof def?.shape === 'function') return Object.keys((def.shape as () => object)())
+    inner = def?.innerType ?? def?.schema
+  }
+  return []
+}
+
+describe('apply-token-only (ADR-0010, PIT-apply-takes-only-the-token)', () => {
+  const applyMethods = Object.entries(METHODS).filter(([name]) => {
+    const short = name.split('.').pop() ?? ''
+    return /^apply[A-Z]/.test(short)
+  })
+
+  it('mọi method apply* chỉ nhận duy nhất previewToken (ngăn SQL chạy lệch SQL xem trước)', () => {
+    expect(applyMethods.length).toBeGreaterThan(0)
+    for (const [name, def] of applyMethods) {
+      const keys = paramKeys((def as { params?: unknown }).params)
+      expect(
+        keys,
+        `Method '${name}' phải nhận duy nhất 'previewToken', nhưng nhận: [${keys.join(', ')}]`,
+      ).toEqual(['previewToken'])
+    }
+  })
+})
